MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>
GEMINI_API_KEY=replace_with_your_server_side_key
GEMINI_MODEL=replace_with_a_model_available_to_your_key
PORT=5000
# Optional when the client and API are hosted on different origins.
# CLIENT_ORIGIN=https://your-client.example
# Optional DNS resolver IPs if your network cannot resolve Atlas SRV records.
# MONGODB_DNS_SERVERS=
